/*
	В этом файле будут показы примеро того что можно сделать в интерфейсе
	игры при помощь RenderOverlay()/RederUnderlay() в Эвент хендлере при помощи
	функций StatusBarCore
*/

Class HUDEventHandler: EventHandler{//Не забываем добавить хендлер в MapInfo
	
	Override Void RenderOverlay(RenderEvent e)
	{
		/*
			В данном примере для отрисовки чего-либо на экране будут использоваться функции
			StatusBarCore (для их вызова будет использоваться гобальная переменная StatusBar)
			
			В сравнении с функциями Screen, функции StatusBarCore более простые и автоматизированные,
			самостоятельно подстраиваясь под соотношение сторон и размеры экрана игрока.
		*/
		
		Let sb = StatusBar;
		
		Vector2 HUDScale = StatusBar.GetHUDScale();
		
		Double Scale = (4 / HUDScale.X) / (4 / StatusBar.defaultScale.X);
		/*
			При умножении всех значений расположения и масштаба нажего худа на эту переменную,
			он будет выглядеть одинаково при любом разрешении и значении масштаба худа в настройках
		*/
		
		bool OriginalOffsets = Sb.FullscreenOffsets;
		Sb.FullScreenOffsets = true;
		
		/*
			При включении данной переменной, наши функции будут рисовать операясь не на виртуальное разрешение
			худа, а на реальное разрешение экрана игрока
			
			дабы не сломать код худа, который может выполняться после нашего, сохраняем предыдущее значение
			переменной, не забывая пременить его в конце
		*/
		
		
		
		/*
			Начнём с отрисовки текста на экране, для чего используем функцию Statusbar.DrawString()
		*/
		HUDFont SmallFnt = HUDFont.Create("SmallFont")//для этого нам сперва надо будет добавить переменную типа HUDFont (обычные шрифты функция не поддерживает)
		//Советую называть переменные HUDFont отлично от глобальных шрифтов, чтобы последнии всё ещё были нам доступны (например для доступа к Font.StringWidth())
		
		Sb.DrawString(SmallFnt, "String in the left corner", (0, SmallFont.GetHeight())*Scale, Sb.DI_SCREEN_TOP|Sb.DI_TEXT_ALIGN_CENTER, Font.CR_WHITE, Scale:(1,1)*Scale);
		
		/*
			Все функции отрисовки StatusBarCore имеют параметр flag, определяющий в каком месте экрана будет рисоваться объект.
			
			Также отдельные функции имеют дополнительные флаги связанные с отрисовкой объекта,
			например, DrawString имеет 3 флага определяющих, как будет выравнен текст
			
			DI_TEXT_ALIGN_LEFT - Текст будет выравнен по левому краю (по умолчанию)
			DI_TEXT_ALIGN_CENTER - Текст будет выравнен по центру
			DI_TEXT_ALIGN_RIGHT - Текст будет выравнен по правому краю
		*/
		
		
	}
}